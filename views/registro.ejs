<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Registro de Usuario</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f4f6f8;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .card {
      width: 420px;
      background: white;
      padding: 30px;
      border-radius: 10px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.12);
    }

    h1 {
      text-align: center;
      margin-bottom: 25px;
    }

    label {
      display: block;
      margin-bottom: 6px;
      font-weight: bold;
    }

    input,
    select {
      width: 100%;
      padding: 10px;
      margin-bottom: 6px;
      border: 1px solid #ccc;
      border-radius: 5px;
    }

    .error {
      color: #dc3545;
      font-size: 13px;
      margin-bottom: 14px;
      min-height: 16px;
    }

    .input-error {
      border-color: #dc3545;
    }

    button {
      width: 100%;
      padding: 11px;
      background: #0d6efd;
      color: white;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      font-size: 16px;
      margin-top: 8px;
    }

    button:hover {
      background: #0b5ed7;
    }

    .login {
      margin-top: 18px;
      text-align: center;
    }

    .login a {
      color: #0d6efd;
      text-decoration: none;
    }
  </style>
</head>

<body>

  <div class="card">

    <h1>Registro de Usuario</h1>

    <form
      id="registroForm"
      action="/auth/registro"
      method="POST"
      novalidate
    >

      <label for="nombre">Nombre:</label>
      <input
        type="text"
        id="nombre"
        name="nombre"
      >
      <div id="errorNombre" class="error"></div>

      <label for="email">Correo:</label>
      <input
        type="email"
        id="email"
        name="email"
      >
      <div id="errorEmail" class="error"></div>

      <label for="password">Contraseña:</label>
      <input
        type="password"
        id="password"
        name="password"
      >
      <div id="errorPassword" class="error"></div>

      <label for="rol">Rol:</label>
      <select id="rol" name="rol">
        <option value="">Seleccione un rol</option>
        <option value="usuario">Usuario</option>
        <option value="moderador">Moderador</option>
        <option value="administrador">Administrador</option>
      </select>
      <div id="errorRol" class="error"></div>

      <button type="submit">
        Registrarse
      </button>

    </form>

    <div class="login">
      <a href="/auth/login">
        Ya tengo una cuenta
      </a>
    </div>

  </div>

  <script>
    const form = document.getElementById('registroForm');

    form.addEventListener('submit', function (event) {
      let valido = true;

      const nombre = document.getElementById('nombre');
      const email = document.getElementById('email');
      const password = document.getElementById('password');
      const rol = document.getElementById('rol');

      const errorNombre = document.getElementById('errorNombre');
      const errorEmail = document.getElementById('errorEmail');
      const errorPassword = document.getElementById('errorPassword');
      const errorRol = document.getElementById('errorRol');

      errorNombre.textContent = '';
      errorEmail.textContent = '';
      errorPassword.textContent = '';
      errorRol.textContent = '';

      nombre.classList.remove('input-error');
      email.classList.remove('input-error');
      password.classList.remove('input-error');
      rol.classList.remove('input-error');

      if (nombre.value.trim().length < 3) {
        errorNombre.textContent =
          'El nombre debe tener al menos 3 caracteres.';
        nombre.classList.add('input-error');
        valido = false;
      }

      const patronEmail =
        /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

      if (!patronEmail.test(email.value.trim())) {
        errorEmail.textContent =
          'Ingrese un correo electrónico válido.';
        email.classList.add('input-error');
        valido = false;
      }

      if (password.value.length < 6) {
        errorPassword.textContent =
          'La contraseña debe tener mínimo 6 caracteres.';
        password.classList.add('input-error');
        valido = false;
      }

      if (rol.value === '') {
        errorRol.textContent =
          'Seleccione un rol.';
        rol.classList.add('input-error');
        valido = false;
      }

      if (!valido) {
        event.preventDefault();
      }
    });
  </script>

</body>
</html>